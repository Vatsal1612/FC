@{
    ViewData["Title"] = "Add-Ons";
    int planId = ViewBag.PlanId ?? 1;
}

<div class="addons-header">
    <div class="addons-title-row">
        <a href="/Subscription" class="btn-back-circle"><i class="fa-solid fa-arrow-left"></i></a>
        <h1 class="header-title m-0">Add-Ons</h1>
        <div class="global-toggle-wrapper addons-toggle mb-0">
            <div class="billing-toggle-container billing-radio-switch" id="addons-cycle-switch" role="radiogroup" aria-label="Add-ons billing cycle">
                <label class="billing-option active" id="addons-toggle-monthly" onclick="switchAddonsCycle('Monthly')">
                    <input type="radio" name="addons-billing-cycle" value="Monthly" checked onchange="switchAddonsCycle('Monthly')" />
                    <span>Monthly</span>
                </label>
                <span class="billing-switch-track" role="switch" tabindex="0" aria-label="Toggle add-ons billing cycle" onclick="switchAddonsCycle(screen2Cycle === 'Monthly' ? 'Yearly' : 'Monthly')" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"><span class="billing-switch-thumb"></span></span>
                <label class="billing-option" id="addons-toggle-yearly" onclick="switchAddonsCycle('Yearly')">
                    <input type="radio" name="addons-billing-cycle" value="Yearly" onchange="switchAddonsCycle('Yearly')" />
                    <span>Yearly</span>
                </label>
            </div>
            <span class="badge-save">Save 40%</span>
        </div>
    </div>
</div>

<div class="screen-container addons-page" data-plan-id="@planId">
    <div class="addons-layout">
        <div class="addons-grid-wrap">
            <div class="addons-grid" id="addons-grid"></div>
        </div>
        <aside class="selection-summary-panel" id="selection-panel">
            <div class="selection-header" style="margin-top: -5px;">Your cart - Business Plan</div>
            <div class="selection-body">
                <div class="selection-line-item base-plan-line" style="margin-top: 5px;">
                    <div>
                        <div class="selection-item-name" id="selection-base-plan-title">POS Lite Plan</div>
                        <div class="selection-item-sub" id="selection-base-plan-sub"></div>
                    </div>
                    <div class="selection-item-price" id="selection-base-plan-price">$10 / Month</div>
                </div>
                <div id="selection-addons-list"></div>
                <div id="selection-total-value" class="selection-total-value" style="display:none;">Total Value: $1,427</div>
                <div class="selection-totals-box">
                    <div class="selection-due-row">
                        <span>Due today <span class="free-trial-highlight">(14 Days Free)</span></span>
                        <span class="selection-box-price">$0.00</span>
                    </div>
                    <div class="selection-next-row">
                        <span>Next Billing: <span id="selection-next-billing-date">24 Jul 2026</span></span>
                        <span id="selection-next-billing-total" class="selection-box-price">$10</span>
                    </div>
                </div>
                <div class="selection-assurances-box">
                    <div class="assurance-line"><svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:6px;vertical-align:-3px;flex-shrink:0;"><circle cx="12" cy="12" r="12" fill="#22c55e"/><path d="M7 13l3 3 7-7" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> <span>Free 14 Days trial, cancel any time</span></div>
                    <div class="assurance-line"><svg viewBox="0 0 24 24" width="16" height="16" style="margin-right:6px;vertical-align:-3px;flex-shrink:0;"><circle cx="12" cy="12" r="12" fill="#22c55e"/><path d="M7 13l3 3 7-7" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg> <span>Your subscription starts on <span id="cart-start-date">Aug 9, 2026</span>, unless you cancel during the trial.</span></div>
                </div>
                <small class="api-status" id="addons-api-status">Loading add-ons...</small>
                <button type="button" class="btn-teal-cta" onclick="openPaymentModal()">Continue to Checkout</button>
            </div>
        </aside>
    </div>
</div>

<input type="hidden" id="screen2-plan-id" value="@planId" />

@section Scripts {
    <script src="~/Scripts/addons.js" asp-append-version="true"></script>
}
