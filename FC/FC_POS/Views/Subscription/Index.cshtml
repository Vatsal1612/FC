@{
    ViewData["Title"] = "My Plan - Upgrade Your Restaurant Growth";
}

<div class="page-header plan-page-heading">
    <h1 class="header-title" id="page-header-title">Upgrade Your Restaurant Growth</h1>
    <p class="header-subtitle" id="page-header-subtitle">Everything you need to run, manage, and grow your restaurant in one place.</p>
</div>

<div class="screen-container">
    <div class="global-toggle-wrapper">
        <div class="billing-toggle-container billing-radio-switch" id="billing-cycle-switch" role="radiogroup" aria-label="Billing cycle">
            <label class="billing-option active" id="global-toggle-monthly" onclick="switchGlobalCycle('Monthly')">
                <input type="radio" name="billing-cycle" value="Monthly" checked onchange="switchGlobalCycle('Monthly')" />
                <span id="label-cycle-monthly">Monthly</span>
            </label>
            <span class="billing-switch-track" role="switch" tabindex="0" aria-label="Toggle billing cycle" onclick="switchGlobalCycle(globalCycle === 'Monthly' ? 'Yearly' : 'Monthly')" onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); this.click(); }"><span class="billing-switch-thumb"></span></span>
            <label class="billing-option" id="global-toggle-yearly" onclick="switchGlobalCycle('Yearly')">
                <input type="radio" name="billing-cycle" value="Yearly" onchange="switchGlobalCycle('Yearly')" />
                <span id="label-cycle-yearly">Yearly</span>
            </label>
        </div>
        <span class="badge-save" id="cycle-discount-badge">Save 40%</span>
    </div>

    <div class="plans-row">
        <!-- 1. POS Plan Card -->
        <div class="pricing-card pos-card">
            <div class="card-top-section">
                <h3 class="card-plan-title" id="pos-plan-title">POS (Point of Sale) Plan</h3>
                <div class="internal-toggle-box" id="pos-tier-box">
                    <button type="button" class="btn-internal-toggle" id="pos-tier-lite" onclick="selectPosTier('Lite')">Lite Plan</button>
                    <button type="button" class="btn-internal-toggle active" id="pos-tier-premium" onclick="selectPosTier('Premium')" style="position: relative;">
                        Premium Plan
                        <div class="card-badge-recommended" id="pos-badge-recommended">Most Recommended</div>
                    </button>
                </div>
                <p class="card-plan-desc" id="pos-desc">Everything a single-outlet restaurant needs to start billing today.</p>
                <div class="price-display-area">
                    <span class="price-amount" id="pos-price-val">$25</span>
                    <span class="price-period" id="pos-period-val"> / Month billed annually</span>
                </div>
            </div>
            <button type="button" class="btn-teal-cta" id="pos-cta-btn" onclick="selectAndNavigatePlan('POS')">Start 14 Day Free Trial</button>
            <ul class="feature-checklist" id="pos-feature-list"></ul>
            <a href="#" class="btn-learn-more" id="pos-learn-more">Learn More</a>
        </div>

        <!-- 2. Growth Plan Card -->
        <div class="pricing-card growth-card">
            <div class="growth-top-banner">
                <span id="growth-title" style="font-weight: 800; font-size: 14px;">Growth Plan</span>
                <span id="growth-badge" style="font-weight: 700; font-size: 12px;">Save 52%</span>
            </div>
            <div class="growth-card-inner">
                <div class="card-top-section growth-top-section">
                    <div class="price-display-area" id="growth-price-area">
                        <div class="growth-price-row">
                            <span class="price-struck" id="growth-price-struck">$1,899</span>
                            <span class="growth-price" id="growth-price-val">$600</span>
                            <span class="growth-price-period" id="growth-price-period">/ Year</span>
                        </div>
                    </div>
                    <div class="growth-features-note">
                        <p class="growth-subtitle" id="growth-subtitle">All Features in One Plan</p>
                        <div class="growth-yearly-note" id="growth-yearly-note">Growth Plan Available on Yearly Plan</div>
                    </div>
                </div>
                <div id="growth-cta-box">
                    <button type="button" class="btn-growth-disabled" id="growth-cta-btn" disabled>Start 14 Day Free Trial</button>
                </div>
                <div class="bundled-values-wrapper" id="growth-bundled-wrapper">
                    <!-- Populated dynamically via database -->
                </div>
                <div class="growth-banners">
                    <div class="banner-guarantee" id="growth-guarantee-banner">250 Orders Guaranteed in 90 Days</div>
                    <div class="banner-total-value" id="growth-total-value">TOTAL VALUE: $1,899</div>
                    <div class="banner-savings" id="growth-savings">
                        <div class="savings-title">You save with Growth Plan</div>
                        <div class="savings-amount">$1,299</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Online Ordering Plan Card -->
        <div class="pricing-card ordering-card">
            <div class="card-top-section">
                <h3 class="card-plan-title" id="ordering-plan-title">Online Ordering Plan</h3>
                <div class="internal-toggle-box" id="ordering-tier-box">
                    <button type="button" class="btn-internal-toggle active" id="ordering-tier-fix" onclick="selectOrderingTier('Fix')">Fix Plan</button>
                    <button type="button" class="btn-internal-toggle" id="ordering-tier-commission" onclick="selectOrderingTier('Commission')">Commission Plan</button>
                </div>
                <p class="card-plan-desc" id="ordering-desc">Predictable cost, unlimited orders.</p>
                <div class="price-display-area">
                    <span class="price-amount" id="ordering-price-val">$30</span>
                    <span class="price-period" id="ordering-period-val"> / Month</span>
                </div>
            </div>
            <button type="button" class="btn-teal-cta" id="ordering-cta-btn" onclick="selectAndNavigatePlan('Ordering')">Start 14 Day Free Trial</button>
            <ul class="feature-checklist" id="ordering-feature-list">
                <!-- Populated dynamically via database -->
            </ul>
            <a href="#" class="btn-learn-more" id="ordering-learn-more">Learn More</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/subscription.js" asp-append-version="true"></script>
}
