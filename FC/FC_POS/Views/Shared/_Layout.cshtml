<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Maharaja Food Admin Panel</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Unbounded:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/subscription.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/addons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/responsive.css" asp-append-version="true" />
</head>
<body class="admin-app-body">

    <div class="trial-teaser-banner" id="trial-banner">
        <div class="trial-banner-copy">
            <strong>Unlock All Premium Features with a FREE 14-Day Trial</strong>
            <span>No payment today - Cancel anytime before trial ends</span>
        </div>
        <div class="trial-banner-actions">
            <a href="/Subscription" class="btn-start-trial">Start Trial <svg width="15" height="12" viewBox="0 0 16 12" xmlns="http://www.w3.org/2000/svg" style="margin-left: 8px;"><path d="M10 1v4H0v2h10v4l6-5-6-5z" fill="#111"/></svg></a>
        </div>
    </div>

    <!-- Icon rail -->
    <aside class="icon-rail" aria-label="Primary navigation">
        <button type="button" class="icon-rail-hamburger" aria-label="Menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <nav class="icon-rail-nav">
            <a href="#" class="icon-rail-item" title="Setup"><img src="~/Content/images/icons/setup.png" alt="" /><span>Setup</span></a>
            <a href="#" class="icon-rail-item" title="Menu"><img src="~/Content/images/icons/menu.png" alt="" /><span>Menu</span></a>
            <a href="#" class="icon-rail-item" title="Marketing"><img src="~/Content/images/icons/marketing.png" alt="" /><span>Marketing</span></a>
            <a href="#" class="icon-rail-item" title="Report"><img src="~/Content/images/icons/report.png" alt="" /><span>Report</span></a>
            <a href="/Subscription" class="icon-rail-item active" title="Plan"><img src="~/Content/images/icons/plan.png" alt="" /><span>Plan</span></a>
            <a href="#" class="icon-rail-item" title="Support"><img src="~/Content/images/icons/support.png" alt="" /><span>Support</span></a>
        </nav>
    </aside>

    <!-- Secondary admin sidebar -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">ADMIN</div>
        <div class="restaurant-selector">
            <div class="restaurant-icon"><img src="~/Content/images/maharaja_icon.png" alt="Maharaja Food"></div>
            <span class="restaurant-name">Maharaja Food</span>
        </div>
        <nav class="admin-subnav">
            <a href="/Subscription" class="subnav-link active"><img src="~/Content/images/icons/my_plan.png" alt="" /> <span>My Plan</span></a>
            <a href="/Subscription" class="subnav-link"><img src="~/Content/images/icons/billing.png" alt="" /> <span>Billing</span></a>
        </nav>
    </aside>

    <div class="main-wrapper">
        <header class="topbar-wrapper">
            <div class="topbar-controls">
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn-header-solid">Create Support Ticket</button>
                    <div class="dropdown">
                        <button class="btn-header-red-outline dropdown-toggle" type="button" data-bs-toggle="dropdown">View</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Dashboard View</a></li>
                            <li><a class="dropdown-item" href="#">POS View</a></li>
                        </ul>
                    </div>
                    <button type="button" class="btn-header-solid">My Profile</button>
                </div>
            </div>
        </header>

        <main role="main" class="content-body">
            @RenderBody()
        </main>
    </div>

    <!-- Shared Razorpay-style Payment Modal -->
    <div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered payment-modal-dialog">
            <div class="modal-content payment-modal-content">
                <div class="rzp-checkout">
                    <aside class="rzp-left">
                        <div class="rzp-merchant">
                            <img src="~/Content/images/foodchow_payment_logo.png" alt="FoodChow Logo" class="rzp-merchant-logo-img">
                            <span class="rzp-merchant-name">FoodChow</span>
                        </div>
                        <div class="rzp-amount-card">
                            <div class="rzp-amount" id="modal-summary-total">$138.00</div>
                        </div>
                        <button type="button" class="rzp-left-row">
                            <span class="rzp-left-ico user"><i class="fa-regular fa-user"></i></span>
                            <span class="rzp-left-copy">
                                <small>Using as</small>
                                <strong>+91 70167 15742</strong>
                            </span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                        <button type="button" class="rzp-left-row">
                            <span class="rzp-offer-stack">
                                <span class="rzp-chip"><img src="~/Content/images/icici.png" alt="ICICI" /></span>
                                <!-- <span class="rzp-mini upi">UPI</span> -->
                            </span>
                            <span class="rzp-left-copy">
                                <strong>Offers on ICICI, UPI and...</strong>
                            </span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                        <div class="rzp-illustration">
                            <svg viewBox="0 0 240 170" width="210" height="140" aria-hidden="true">
                                <defs>
                                    <linearGradient id="bag1" x1="0" x2="0" y1="0" y2="1">
                                        <stop offset="0%" stop-color="#ffffff"/>
                                        <stop offset="100%" stop-color="#d7e8ff"/>
                                    </linearGradient>
                                </defs>
                                <ellipse cx="120" cy="158" rx="62" ry="8" fill="rgba(0,30,80,0.18)"/>
                                <g transform="translate(18,36)">
                                    <path d="M34 20c0-16 11-28 26-28s26 12 26 28" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round"/>
                                    <rect x="14" y="18" width="80" height="88" rx="10" fill="url(#bag1)"/>
                                    <rect x="14" y="18" width="80" height="20" fill="#7eb6ff"/>
                                </g>
                                <g transform="translate(92,18)">
                                    <path d="M40 28c0-20 14-34 32-34s32 14 32 34" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
                                    <rect x="16" y="26" width="100" height="104" rx="12" fill="#f4f8ff"/>
                                    <rect x="16" y="26" width="100" height="24" fill="#3b82f6"/>
                                    <circle cx="108" cy="22" r="20" fill="#ffcc33"/>
                                    <text x="108" y="29" text-anchor="middle" font-size="18" font-weight="800" fill="#1e3a8a">%</text>
                                </g>
                            </svg>
                        </div>
                        <div class="rzp-secured">
                            <span>Secured by</span>
                            <strong class="rzp-wordmark">Razorpay</strong>
                        </div>
                    </aside>

                    <section class="rzp-right">
                        <header class="rzp-right-head">
                            <h5>Payment Options</h5>
                            <div class="rzp-head-actions">
                                <button type="button" class="rzp-icon-btn" aria-label="More" style="position: relative; top: -3px;">&#8230;</button>
                                <button type="button" class="rzp-icon-btn" data-bs-dismiss="modal" aria-label="Close">&times;</button>
                            </div>
                        </header>

                        <div class="rzp-body">
                            <!-- Left-hand list of payment methods -->
                            <nav class="rzp-methods-nav" role="tablist" aria-label="Payment methods">
                                <button type="button" class="rzp-method-nav-item" data-panel="upi" onclick="selectPaymentMethod('upi')">
                                    <div class="rzp-method-nav-top">
                                        <span class="rzp-method-nav-label">UPI</span>
                                        <span class="rzp-method-nav-badge offers">2 Offers</span>
                                    </div>
                                    <div class="rzp-method-nav-icons">
                                        <span class="rzp-mini-logo"><img src="~/Content/images/gpay.jpg" alt="GPay" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/phonepe.jpg"  alt="PhonePe" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/pop.jpg" alt="PopUpi" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/paytm.png" alt="Paytm" /></span>
                                    </div>
                                </button>

                                <button type="button" class="rzp-method-nav-item active" data-panel="cards" onclick="selectPaymentMethod('cards')">
                                    <div class="rzp-method-nav-top">
                                        <span class="rzp-method-nav-label">Cards</span>
                                        <span class="rzp-method-nav-badge cash">Unlimited 1% cash...</span>
                                    </div>
                                    <div class="rzp-method-nav-icons">
                                        <span class="rzp-mini-logo"><img src="~/Content/images/visa.png" alt="Visa" /></span>
                                        <span class="rzp-mini-logo"><img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="Mastercard" /></span>
                                        <span class="rzp-mini-logo"><img src="https://upload.wikimedia.org/wikipedia/commons/d/d1/RuPay.svg" alt="RuPay" /></span>
                                        <span class="rzp-mini-logo"><img src="https://upload.wikimedia.org/wikipedia/commons/f/fd/Maestro_logo.svg" alt="Maestro" /></span>
                                    </div>
                                </button>

                                <button type="button" class="rzp-method-nav-item" data-panel="netbanking" onclick="selectPaymentMethod('netbanking')">
                                    <div class="rzp-method-nav-top">
                                        <span class="rzp-method-nav-label">Netbanking</span>
                                    </div>
                                    <div class="rzp-method-nav-icons">
                                        <span class="rzp-mini-logo"><img src="~/Content/images/bob.png" alt="BOB" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/canarabank.png" alt="Canara" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/punjab.jpg" alt="PNB" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/hdfc.png" alt="HDFC" /></span>
                                    </div>
                                </button>

                                <button type="button" class="rzp-method-nav-item" data-panel="wallet" onclick="selectPaymentMethod('wallet')">
                                    <div class="rzp-method-nav-top">
                                        <span class="rzp-method-nav-label">Wallet</span>
                                    </div>
                                    <div class="rzp-method-nav-icons">
                                        <span class="rzp-mini-logo"><img src="~/Content/images/amazon_pay.png" alt="Amazon Pay" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/mobikwik.png" alt="MobiKwik" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/airtel.png" alt="Airtel" /></span>
                                        <span class="rzp-mini-logo"><img src="~/Content/images/olamoney.png" alt="Ola Money" /></span>

                                    </div>
                                </button>
                            </nav>

                            <!-- Right-hand detail pane for the selected method -->
                            <div class="rzp-detail">
                                <div class="rzp-detail-panel" data-panel="upi" hidden>
                                    <div class="rzp-block-head"><span>Pay via UPI</span></div>
                                    <div class="rzp-method-row">
                                        <button type="button" class="rzp-method">
                                            <span class="rzp-logo"><img src="~/Content/images/gpay.jpg" alt="GPay" /></span>
                                            <span>GPay</span>
                                        </button>
                                        <button type="button" class="rzp-method">
                                            <span class="rzp-logo"><img src="~/Content/images/phonepe.jpg" alt="PhonePe" /></span>
                                            <span>PhonePe</span>
                                        </button>
                                        <button type="button" class="rzp-method">
                                            <span class="rzp-logo"><img src="~/Content/images/amazon_pay.png" alt="Amazon Pay" /></span>
                                            <span>Amazon Pay</span>
                                        </button>
                                        <button type="button" class="rzp-method">
                                            <span class="rzp-logo"><img src="~/Content/images/mobikwik.png" alt="Mobikwik" /></span>
                                            <span>Mobikwik</span>
                                        </button>
                                    </div>
                                </div>

                                <div class="rzp-detail-panel active" data-panel="cards">
                                    <div class="rzp-block-head" style="margin-bottom: 8px;">
                                        <span>Available Offers</span>
                                    </div>
                                    <div class="rzp-offers-row">
                                        <div class="rzp-offer-pill active">
                                            <span class="rzp-offer-logo"><img src="~/Content/images/icici.png" alt="ICICI" /></span>
                                            <span class="rzp-offer-text">Unlimited 1% cashback with Amaz...</span>
                                            <span class="rzp-offer-check"><svg width="12" height="12" viewBox="0 0 24 24" fill="#16a34a"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg></span>
                                        </div>
                                        <button type="button" class="rzp-view-all-pill">
                                            <div class="rzp-view-all-icons">
                                                <span class="rzp-mini-logo" style="width:16px;height:16px;border:0;background:transparent;margin-right:-8px;z-index:2;"><img src="~/Content/images/hdfc.png" alt="HDFC"></span>
                                                <span class="rzp-mini-logo" style="width:16px;height:16px;border:0;background:transparent;"><img src="~/Content/images/visa.png" alt="Visa"></span>
                                            </div>
                                            <span>View all</span>
                                        </button>
                                    </div>

                                    <div class="rzp-form-title">Add a new card</div>
                                    <div class="rzp-card-inputs">
                                        <input type="text" class="rzp-input card-num" placeholder="Card Number" id="card-num" maxlength="19" />
                                        <div class="rzp-input-split">
                                            <input type="text" class="rzp-input card-exp" placeholder="MM / YY" id="card-exp" maxlength="7" />
                                            <input type="password" class="rzp-input card-cvv" placeholder="CVV" id="card-cvv" maxlength="4" />
                                        </div>
                                    </div>
                                    <label class="rzp-rbi">
                                        <input type="checkbox" id="save-card-rbi" checked />
                                        <span>Save this card as per RBI guidelines</span>
                                    </label>
                                </div>

                                <div class="rzp-detail-panel" data-panel="netbanking" hidden>
                                    <div class="rzp-block-head"><span>Select your bank</span></div>
                                    <div class="rzp-chip-row">
                                        <span class="rzp-chip"><img src="~/Content/images/bob.png" alt="BOB" /></span>
                                        <span class="rzp-chip"><img src="~/Content/images/hdfc.png" alt="HDFC" /></span>
                                        <span class="rzp-chip"><img src="~/Content/images/punjab.jpg"  alt="PNB" /></span>
                                        <span class="rzp-chip"><img src="~/Content/images/canarabank.png" alt="Canara" /></span>
                                    </div>
                                </div>

                                <div class="rzp-detail-panel" data-panel="wallet" hidden>
                                    <div class="rzp-block-head"><span>Select a wallet</span></div>
                                    <div class="rzp-chip-row">
                                        <span class="rzp-chip"><img src="~/Content/images/olamoney.png" alt="Ola Money" /></span>
                                        <span class="rzp-chip"><img src="~/Content/images/mobikwik.png" alt="MobiKwik" /></span>
                                        <span class="rzp-chip"><img src="~/Content/images/airtel.png" alt="Airtel" /></span>
                                        <span class="rzp-chip"><img src="~/Content/images/amazon_pay.png" alt="Amazon Pay" /></span>
                                    </div>
                                </div>
                                
                                <button type="button" class="rzp-continue" id="btn-modal-continue" onclick="confirmModalPayment()">Continue</button>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/api.js" asp-append-version="true"></script>
    <script src="~/Scripts/checkout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
