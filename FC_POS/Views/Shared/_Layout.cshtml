<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Maharaja Food Admin Panel</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Content/css/subscription.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/addons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/cart.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/checkout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Content/css/responsive.css" asp-append-version="true" />
</head>
<body class="admin-app-body">

    <div class="trial-teaser-banner" id="trial-banner">
        <div class="trial-banner-copy">
            <strong>Unlock All Premium Features with a FREE 14-Day Trial</strong>
            <span>No payment today - Cancel anytime before trial ends</span>
        </div>
        <div class="trial-banner-actions">
            <a href="/Subscription" class="btn-start-trial">Start Trial &rarr;</a>
            <button type="button" class="btn-close-banner" onclick="document.body.classList.add('banner-hidden'); document.getElementById('trial-banner').style.display='none'" aria-label="Dismiss">&times;</button>
        </div>
    </div>

    <!-- Icon rail -->
    <aside class="icon-rail" aria-label="Primary navigation">
        <button type="button" class="icon-rail-hamburger" aria-label="Menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <nav class="icon-rail-nav">
            <a href="#" class="icon-rail-item" title="Setup"><i class="fa-solid fa-gear"></i><span>Setup</span></a>
            <a href="#" class="icon-rail-item" title="Menu"><i class="fa-solid fa-utensils"></i><span>Menu</span></a>
            <a href="#" class="icon-rail-item" title="Marketing"><i class="fa-solid fa-bullhorn"></i><span>Marketing</span></a>
            <a href="#" class="icon-rail-item" title="Report"><i class="fa-solid fa-chart-simple"></i><span>Report</span></a>
            <a href="/Subscription" class="icon-rail-item active" title="Plan"><i class="fa-solid fa-clipboard-list"></i><span>Plan</span></a>
            <a href="#" class="icon-rail-item" title="Support"><i class="fa-solid fa-headset"></i><span>Support</span></a>
        </nav>
    </aside>

    <!-- Secondary admin sidebar -->
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">ADMIN</div>
        <div class="restaurant-selector">
            <div class="restaurant-icon"><i class="fa-solid fa-store"></i></div>
            <span class="restaurant-name">Maharaja Food</span>
        </div>
        <nav class="admin-subnav">
            <a href="/Subscription" class="subnav-link active"><i class="fa-regular fa-user"></i> My Plan</a>
            <a href="/Subscription/Cart" class="subnav-link"><i class="fa-regular fa-credit-card"></i> Billing</a>
        </nav>
    </aside>

    <div class="main-wrapper">
        <header class="topbar-wrapper">
            <div class="topbar-controls">
                <div class="ms-auto d-flex align-items-center gap-2">
                    <button type="button" class="btn-header-outline">Create Support Ticket</button>
                    <div class="dropdown">
                        <button class="btn-header-outline dropdown-toggle" type="button" data-bs-toggle="dropdown">View</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#">Dashboard View</a></li>
                            <li><a class="dropdown-item" href="#">POS View</a></li>
                        </ul>
                    </div>
                    <button type="button" class="btn-header-solid">My Profile</button>
                </div>
            </div>
        </header>

        <main role="main" class="content-body">
            @RenderBody()
        </main>
    </div>

    <!-- Shared Razorpay-style Payment Modal -->
    <div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered payment-modal-dialog">
            <div class="modal-content payment-modal-content">
                <div class="rzp-checkout">
                    <aside class="rzp-left">
                        <div class="rzp-merchant">
                            <img src="https://www.foodchow.com/images/favicon.png" alt="FoodChow Logo" class="rzp-merchant-logo" />
                            <span class="rzp-merchant-name">FoodChow</span>
                        </div>
                        <div class="rzp-amount-card">
                            <div class="rzp-amount" id="modal-summary-total">₹5,475</div>
                        </div>
                        <button type="button" class="rzp-left-row">
                            <span class="rzp-left-ico user"><i class="fa-regular fa-user"></i></span>
                            <span class="rzp-left-copy">
                                <small>Using as</small>
                                <strong>+91 70167 15742</strong>
                            </span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                        <button type="button" class="rzp-left-row">
                            <span class="rzp-offer-stack">
                                <span class="rzp-mini icici">ICICI</span>
                                <span class="rzp-mini upi">UPI</span>
                            </span>
                            <span class="rzp-left-copy">
                                <strong>Offers on ICICI, UPI and...</strong>
                            </span>
                            <i class="fa-solid fa-chevron-right"></i>
                        </button>
                        <div class="rzp-illustration">
                            <svg viewBox="0 0 240 170" width="210" height="140" aria-hidden="true">
                                <defs>
                                    <linearGradient id="bag1" x1="0" x2="0" y1="0" y2="1">
                                        <stop offset="0%" stop-color="#ffffff"/>
                                        <stop offset="100%" stop-color="#d7e8ff"/>
                                    </linearGradient>
                                </defs>
                                <ellipse cx="120" cy="158" rx="62" ry="8" fill="rgba(0,30,80,0.18)"/>
                                <g transform="translate(18,36)">
                                    <path d="M34 20c0-16 11-28 26-28s26 12 26 28" fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round"/>
                                    <rect x="14" y="18" width="80" height="88" rx="10" fill="url(#bag1)"/>
                                    <rect x="14" y="18" width="80" height="20" fill="#7eb6ff"/>
                                </g>
                                <g transform="translate(92,18)">
                                    <path d="M40 28c0-20 14-34 32-34s32 14 32 34" fill="none" stroke="#fff" stroke-width="9" stroke-linecap="round"/>
                                    <rect x="16" y="26" width="100" height="104" rx="12" fill="#f4f8ff"/>
                                    <rect x="16" y="26" width="100" height="24" fill="#3b82f6"/>
                                    <circle cx="108" cy="22" r="20" fill="#ffcc33"/>
                                    <text x="108" y="29" text-anchor="middle" font-size="18" font-weight="800" fill="#1e3a8a">%</text>
                                </g>
                            </svg>
                        </div>
                        <div class="rzp-secured">
                            <span>Secured by</span>
                            <strong class="rzp-wordmark">Razorpay</strong>
                        </div>
                    </aside>

                    <section class="rzp-right">
                        <header class="rzp-right-head">
                            <h5 style="margin: 0 auto;">Payment Options</h5>
                            <div class="rzp-head-actions" style="position: absolute; right: 18px;">
                                <button type="button" class="rzp-icon-btn" aria-label="More">&#8230;</button>
                                <button type="button" class="rzp-icon-btn" data-bs-dismiss="modal" aria-label="Close">&times;</button>
                            </div>
                        </header>

                        <div class="rzp-split-body">
                            <!-- Sidebar -->
                            <div class="rzp-sidebar">
                                <div class="rzp-sidebar-item">
                                    <div class="rzp-sb-main">
                                        <div class="rzp-sb-text">UPI</div>
                                        <div class="rzp-sb-icons">
                                            <span class="rzp-logo-sm" style="color: #4285f4; font-weight:800; font-family:sans-serif;">G</span>
                                            <span class="rzp-logo-sm" style="background:#5f259f; color:#fff; padding:1px 3px; border-radius:3px;">Pe</span>
                                            <span class="rzp-logo-sm" style="color:#00baf2; font-weight:800; font-size:9px;">paytm</span>
                                        </div>
                                    </div>
                                    <div class="rzp-sb-pill green">2 Offers</div>
                                </div>
                                <div class="rzp-sidebar-item active">
                                    <div class="rzp-sb-main">
                                        <div class="rzp-sb-text">Cards</div>
                                        <div class="rzp-sb-icons">
                                            <span class="rzp-logo-sm" style="color:#1a1f71; font-weight:800; font-size:9px;">VISA</span>
                                            <span class="rzp-logo-sm" style="color:#eb001b; font-weight:800; font-size:9px;">MC</span>
                                        </div>
                                    </div>
                                    <div class="rzp-sb-pill light-green">Unlimited 1% cash...</div>
                                </div>
                                <div class="rzp-sidebar-item">
                                    <div class="rzp-sb-main">
                                        <div class="rzp-sb-text">Netbanking</div>
                                        <div class="rzp-sb-icons">
                                            <span class="rzp-logo-sm" style="color:#eb5202; font-weight:800; font-size:9px;">SBI</span>
                                            <span class="rzp-logo-sm" style="color:#004c8f; font-weight:800; font-size:9px;">HDFC</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="rzp-sidebar-item">
                                    <div class="rzp-sb-main">
                                        <div class="rzp-sb-text">Wallet</div>
                                        <div class="rzp-sb-icons">
                                            <span class="rzp-logo-sm" style="color:#333; font-weight:800; font-size:9px;">Mobi</span>
                                            <span class="rzp-logo-sm" style="color:#111; font-weight:800; font-size:9px;">Pay</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Main Content -->
                            <div class="rzp-content">
                                <div class="rzp-block" style="margin-top: 18px;">
                                    <div class="rzp-block-head">
                                        <span style="color: #6b7280; font-weight: 500;">Available Offers</span>
                                    </div>
                                    <div class="rzp-offer" style="border: 1px solid #ff7b5a; background: #fff5f2; justify-content: space-between; border-radius: 20px; padding: 6px 14px;">
                                        <div style="display: flex; align-items: center; gap: 8px;">
                                            <span style="color: #ea4335; font-weight: 900; font-style: italic; font-size: 16px;">f</span>
                                            <span style="font-size: 12px; font-weight: 600;">Unlimited 1% cashback with Amaz...</span>
                                            <span style="background: #22c55e; color: #fff; border-radius: 50%; width: 14px; height: 14px; display: flex; align-items: center; justify-content: center; font-size: 9px;">&#10003;</span>
                                        </div>
                                        <a href="#" class="rzp-view-all" style="background: #f4f8ff; padding: 4px 10px; border-radius: 14px; color: #1a73e8; text-decoration: none; font-size: 11px; font-weight: 700; display:flex; align-items:center; gap:4px;">
                                            <span style="color:#ea4335;">&#x1F3F7;</span> View all
                                        </a>
                                    </div>
                                </div>

                                <div class="rzp-block">
                                    <div class="rzp-block-head">
                                        <span style="color: #6b7280; font-weight: 500;">Add a new card</span>
                                    </div>
                                    <div class="rzp-card-form" style="border: 1px solid #e5e7eb; border-radius: 8px; padding: 0;">
                                        <input type="text" class="rzp-input" placeholder="Card Number" id="card-num" maxlength="19" style="border: none; border-bottom: 1px solid #e5e7eb; border-radius: 8px 8px 0 0; margin-bottom: 0; padding: 12px 14px;" />
                                        <div class="rzp-input-split" style="gap: 0;">
                                            <input type="text" class="rzp-input" placeholder="MM / YY" id="card-exp" maxlength="7" style="border: none; border-right: 1px solid #e5e7eb; border-radius: 0 0 0 8px; margin-bottom: 0; padding: 12px 14px;" />
                                            <input type="password" class="rzp-input" placeholder="CVV" id="card-cvv" maxlength="4" style="border: none; border-radius: 0 0 8px 0; margin-bottom: 0; padding: 12px 14px;" />
                                        </div>
                                    </div>
                                    <label class="rzp-rbi" style="margin-top: 14px;">
                                        <input type="checkbox" id="save-card-rbi" />
                                        <span>Save this card as per RBI guidelines</span>
                                    </label>
                                </div>

                                <div style="margin-top: auto; padding-bottom: 24px;">
                                    <button type="button" class="rzp-continue" id="btn-modal-continue" onclick="confirmModalPayment()" style="margin: 0; width: 100%; border-radius: 6px;">Continue</button>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/api.js" asp-append-version="true"></script>
    <script src="~/Scripts/checkout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
