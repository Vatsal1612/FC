@{
    ViewData["Title"] = "Subscription Activated!";
    int subId = ViewBag.SubscriptionId;
}

<div class="container py-5 text-center">
    <div class="card shadow-lg border-0 rounded-4 max-w-700 mx-auto p-5">
        <div class="success-icon-wrapper mb-4">
            <div class="success-circle shadow-sm">
                <i class="fa-solid fa-check text-white fs-1"></i>
            </div>
        </div>

        <h1 class="fw-bold text-success mb-2">Subscription Activated!</h1>
        <p class="text-secondary fs-5 mb-4">Thank you! Your 14-day free trial has been initialized successfully.</p>

        <div class="alert alert-light border p-4 text-start rounded-3 mb-4" id="success-details-box">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Subscription Reference ID:</span>
                <span class="fw-bold text-dark" id="sub-ref-id">#SUB-@subId</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Account Status:</span>
                <span class="badge bg-success" id="sub-status">Trial (Active)</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted">Trial Expiration Date:</span>
                <span class="fw-semibold text-dark" id="sub-trial-date">14 Days from Today</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Next Renewal Amount:</span>
                <span class="fw-bold text-primary" id="sub-amount">$0.00</span>
            </div>
        </div>

        <div class="d-flex gap-3 justify-content-center">
            <a href="/Subscription" class="btn btn-outline-primary btn-lg px-4"><i class="fa-solid fa-house me-1"></i> Return to Dashboard</a>
            <button class="btn btn-primary btn-lg px-4" onclick="window.print()"><i class="fa-solid fa-print me-1"></i> Print Receipt</button>
        </div>
    </div>
</div>

<input type="hidden" id="success-sub-id" value="@subId" />

@section Scripts {
    <script>
        $(document).ready(function() {
            var subId = $('#success-sub-id').val();
            if (subId > 0 && typeof ApiClient !== 'undefined') {
                ApiClient.getSubscription(subId)
                    .done(function(data) {
                        if (data) {
                            $('#sub-ref-id').text('#SUB-' + data.subscriptionId);
                            $('#sub-status').text(data.status + ' (14-Day Free Trial)');
                            $('#sub-amount').text('$' + parseFloat(data.amount).toFixed(2));
                            if (data.trialEndDate) {
                                $('#sub-trial-date').text(new Date(data.trialEndDate).toLocaleDateString());
                            }
                        }
                    });
            }
        });
    </script>
}
